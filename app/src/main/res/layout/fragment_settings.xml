<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_screen">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:text="@string/title_settings"
            android:textColor="@color/textColorPrimary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLangLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/margin_section"
            android:text="@string/label_language"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_label" />

        <RadioGroup
            android:id="@+id/rgLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvLangLabel"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbLangEn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:maxLines="1"
                android:text="@string/lang_english"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbLangDe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/lang_german"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvCountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rgLanguage"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/margin_section"
            android:text="@string/label_questions_count"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_label" />

        <RadioGroup
            android:id="@+id/rgQuestionsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCountLabel"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCount5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:maxLines="1"
                android:text="@string/count_5"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbCount7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/count_7"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbCount10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/count_10"
                android:textSize="13sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvTimerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rgQuestionsCount"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/margin_section"
            android:text="@string/label_timer"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_label" />

        <RadioGroup
            android:id="@+id/rgTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTimerLabel"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbTimer20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:maxLines="1"
                android:text="@string/timer_20s"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbTimer30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/timer_30s"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbTimer60"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/timer_60s"
                android:textSize="13sp" />
        </RadioGroup>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/btn_next" />
        </FrameLayout>

    </RelativeLayout>
</ScrollView>