<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_test_type"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="@dimen/padding_screen">

    <Button
        android:id="@+id/btnBackToSettings"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="@string/btn_back_to_settings" />

    <TextView
        android:id="@+id/tvTestTypeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnBackToSettings"
        android:layout_marginTop="12dp"
        android:text="@string/title_choose_test_type"
        android:textColor="@color/textColorPrimary"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardChoiceTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTestTypeTitle"
        android:layout_marginTop="@dimen/margin_section"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/card_choice_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_choice_border"
        app:strokeWidth="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvChoiceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_choice_title"
                android:textColor="@color/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChoiceDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvChoiceTitle"
                android:layout_marginTop="4dp"
                android:text="@string/mode_choice_desc"
                android:textColor="@color/textColorSecondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnStartChoiceTest"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_below="@id/tvChoiceDesc"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/card_choice_border"
                android:text="@string/btn_start_test" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInputTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardChoiceTest"
        android:layout_marginTop="@dimen/margin_section"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/card_input_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_input_border"
        app:strokeWidth="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvInputTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_input_title"
                android:textColor="@color/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInputDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvInputTitle"
                android:layout_marginTop="4dp"
                android:text="@string/mode_input_desc"
                android:textColor="@color/textColorSecondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnStartInputTest"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_below="@id/tvInputDesc"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/card_input_border"
                android:text="@string/btn_start_test" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>