<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_test"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="@dimen/padding_screen">

    <Button
        android:id="@+id/btnExitTest"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="@string/btn_back_to_settings"
        android:textColor="@color/colorPrimary"
        app:strokeColor="@color/colorPrimary" />

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/btnExitTest"
        android:layout_alignBottom="@id/btnExitTest"
        android:layout_alignParentEnd="true"
        android:gravity="center_vertical"
        android:text="00:20"
        android:textColor="@color/colorAccent"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_alignParentBottom="true"
        android:enabled="false"
        android:gravity="center"
        android:text="@string/btn_continue" />

    <TextView
        android:id="@+id/tvCorrectAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnContinue"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textColor="@color/color_correct"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tvCorrectAnswer"
        android:layout_below="@id/btnExitTest"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvQuestionCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Питання 1 з 5"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_label" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWord"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_below="@id/tvQuestionCounter"
                    android:layout_marginTop="@dimen/margin_small"
                    app:cardBackgroundColor="@color/cardBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/btn_disabled_bg"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/tvOriginalWord"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Word"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <RelativeLayout
                    android:id="@+id/layoutChoiceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/cardWord"
                    android:layout_marginTop="@dimen/margin_section">

                    <Button
                        android:id="@+id/btnOption1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/textColorPrimary" />

                    <Button
                        android:id="@+id/btnOption2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_below="@id/btnOption1"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/textColorPrimary" />

                    <Button
                        android:id="@+id/btnOption3"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_below="@id/btnOption2"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/textColorPrimary" />

                    <Button
                        android:id="@+id/btnOption4"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_below="@id/btnOption3"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/textColorPrimary" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/layoutInputContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/cardWord"
                    android:layout_marginTop="@dimen/margin_section"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAnswer"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/label_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnCheckInput"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_below="@id/tilAnswer"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:text="@string/btn_check" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvUserAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/cardWord"
                    android:layout_marginTop="@dimen/margin_section"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </RelativeLayout>
        </ScrollView>
    </FrameLayout>

</RelativeLayout>